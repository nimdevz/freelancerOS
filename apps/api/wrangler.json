{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "freelanceros-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "freelanceros-files"
    }
  ],
  "triggers": {
    "crons": ["0 * * * *"]
  }
}
