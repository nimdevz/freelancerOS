{
  "name": "freelanceros-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "build": "pnpm -r --filter=!./apps/web run build && pnpm --filter=@freelanceros/web run build",
    "dev:api": "pnpm --filter=@freelanceros/api run dev",
    "dev:worker": "pnpm --filter=@freelanceros/api run dev:worker",
    "dev:web": "pnpm --filter=@freelanceros/web run dev",
    "dev": "pnpm -r --parallel run dev",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test",
    "seed": "pnpm --filter=@freelanceros/api run seed",
    "db:generate": "pnpm --filter=@freelanceros/api run db:generate",
    "db:migrate": "pnpm --filter=@freelanceros/api run db:migrate",
    "db:push": "pnpm --filter=@freelanceros/api run db:push",
    "db:studio": "pnpm --filter=@freelanceros/api run db:studio",
    "deploy:worker": "pnpm --filter=@freelanceros/api run deploy:worker",
    "deploy:web": "wrangler pages deploy apps/web/out --project-name=freelanceros",
    "deploy": "pnpm run deploy:worker"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
