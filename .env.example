# FreelancerOS Environment Variables Template

# Turso / libSQL Database (Server-Only)
# For cloud Turso: libsql://[your-database-name]-[org-name].turso.io
# For local offline SQLite development: file:data/freelanceros.db
TURSO_DATABASE_URL=file:data/freelanceros.db
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# Google OAuth Credentials
NEXT_PUBLIC_GOOGLE_CLIENT_ID=362907268046-lvln83c11jc8ljqope283kgh9juj944u.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# API & Server Configuration
NEXT_PUBLIC_API_URL=http://localhost:4000/api
PORT=4000
